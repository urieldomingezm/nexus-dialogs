{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "nexus-dialogs/toast": ["./src/toast.ts"],
      "nexus-dialogs/forms": ["./src/forms.ts"],
      "nexus-dialogs": ["./src/index.ts"]
    }
  },
  "include": ["src"]
}
