{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "nexus-dialogs/toast": ["./src/toast.ts"],
      "nexus-dialogs/forms": ["./src/forms.ts"],
      "nexus-dialogs/patterns": ["./src/patterns.ts"],
      "nexus-dialogs/mx": ["./src/mx.ts"],
      "nexus-dialogs/themes": ["./src/themes.ts"],
      "nexus-dialogs/import": ["./src/import.ts"],
      "nexus-dialogs/table": ["./src/table.ts"],
      "nexus-dialogs/tabs": ["./src/tabs.ts"],
      "nexus-dialogs/timeline": ["./src/timeline.ts"],
      "nexus-dialogs/sepomex": ["./src/sepomex.ts"],
      "nexus-dialogs/rrhh": ["./src/rrhh.ts"],
      "nexus-dialogs/swal": ["./src/swal.ts"],
      "nexus-dialogs": ["./src/index.ts"]
    }
  },
  "include": ["src", "site", "test/tipos"]
}
