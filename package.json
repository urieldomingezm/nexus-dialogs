{
  "name": "nexus-dialogs",
  "version": "1.0.0",
  "description": "Modals, alerts, confirmations, forms, wizards, toasts and drawers built on the native <dialog>: accessible, isolated with Shadow DOM, promise-based and dependency-free.",
  "license": "MIT",
  "author": "Angel Uriel Domínguez Medina (DevMedina) (https://devmedina.is-a.dev/)",
  "homepage": "https://github.com/urieldomingezm/nexus-dialogs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/urieldomingezm/nexus-dialogs.git"
  },
  "bugs": "https://github.com/urieldomingezm/nexus-dialogs/issues",
  "type": "module",
  "main": "./dist/nexus-dialogs.umd.cjs",
  "module": "./dist/nexus-dialogs.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/nexus-dialogs.all.iife.js",
  "jsdelivr": "./dist/nexus-dialogs.all.iife.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/nexus-dialogs.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/nexus-dialogs.umd.cjs"
      }
    },
    "./forms": {
      "import": {
        "types": "./dist/forms.d.ts",
        "default": "./dist/forms.js"
      },
      "require": {
        "types": "./dist/forms.d.cts",
        "default": "./dist/forms.cjs"
      }
    },
    "./toast": {
      "import": {
        "types": "./dist/toast.d.ts",
        "default": "./dist/toast.js"
      },
      "require": {
        "types": "./dist/toast.d.cts",
        "default": "./dist/toast.cjs"
      }
    },
    "./themes": {
      "import": {
        "types": "./dist/themes.d.ts",
        "default": "./dist/themes.js"
      },
      "require": {
        "types": "./dist/themes.d.cts",
        "default": "./dist/themes.umd.cjs"
      }
    },
    "./patterns": {
      "import": {
        "types": "./dist/patterns.d.ts",
        "default": "./dist/patterns.js"
      },
      "require": {
        "types": "./dist/patterns.d.cts",
        "default": "./dist/patterns.cjs"
      }
    },
    "./mx": {
      "import": {
        "types": "./dist/mx.d.ts",
        "default": "./dist/mx.js"
      },
      "require": {
        "types": "./dist/mx.d.cts",
        "default": "./dist/mx.umd.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "default": "./dist/angular.js"
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./swal": {
      "import": {
        "types": "./dist/swal.d.ts",
        "default": "./dist/swal.js"
      },
      "require": {
        "types": "./dist/swal.d.cts",
        "default": "./dist/swal.cjs"
      }
    },
    "./import": {
      "import": {
        "types": "./dist/import.d.ts",
        "default": "./dist/import.js"
      },
      "require": {
        "types": "./dist/import.d.cts",
        "default": "./dist/import.cjs"
      }
    },
    "./locales": {
      "import": {
        "types": "./dist/locales.d.ts",
        "default": "./dist/locales.js"
      },
      "require": {
        "types": "./dist/locales.d.cts",
        "default": "./dist/locales.cjs"
      }
    },
    "./timeline": {
      "import": {
        "types": "./dist/timeline.d.ts",
        "default": "./dist/timeline.js"
      },
      "require": {
        "types": "./dist/timeline.d.cts",
        "default": "./dist/timeline.cjs"
      }
    },
    "./tabs": {
      "import": {
        "types": "./dist/tabs.d.ts",
        "default": "./dist/tabs.js"
      },
      "require": {
        "types": "./dist/tabs.d.cts",
        "default": "./dist/tabs.cjs"
      }
    },
    "./table": {
      "import": {
        "types": "./dist/table.d.ts",
        "default": "./dist/table.js"
      },
      "require": {
        "types": "./dist/table.d.cts",
        "default": "./dist/table.cjs"
      }
    },
    "./sepomex": {
      "import": {
        "types": "./dist/sepomex.d.ts",
        "default": "./dist/sepomex.js"
      },
      "require": {
        "types": "./dist/sepomex.d.cts",
        "default": "./dist/sepomex.cjs"
      }
    },
    "./rrhh": {
      "import": {
        "types": "./dist/rrhh.d.ts",
        "default": "./dist/rrhh.js"
      },
      "require": {
        "types": "./dist/rrhh.d.cts",
        "default": "./dist/rrhh.cjs"
      }
    },
    "./all": {
      "import": {
        "types": "./dist/global.d.ts",
        "default": "./dist/nexus-dialogs.all.js"
      },
      "default": {
        "types": "./dist/global.d.ts",
        "default": "./dist/nexus-dialogs.all.js"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "nexus-dialogs-sepomex": "bin/sepomex.mjs"
  },
  "typesVersions": {
    "*": {
      "forms": [
        "./dist/forms.d.ts"
      ],
      "toast": [
        "./dist/toast.d.ts"
      ],
      "themes": [
        "./dist/themes.d.ts"
      ],
      "patterns": [
        "./dist/patterns.d.ts"
      ],
      "mx": [
        "./dist/mx.d.ts"
      ],
      "vue": [
        "./dist/vue.d.ts"
      ],
      "angular": [
        "./dist/angular.d.ts"
      ],
      "react": [
        "./dist/react.d.ts"
      ],
      "swal": [
        "./dist/swal.d.ts"
      ],
      "import": [
        "./dist/import.d.ts"
      ],
      "table": [
        "./dist/table.d.ts"
      ],
      "tabs": [
        "./dist/tabs.d.ts"
      ],
      "timeline": [
        "./dist/timeline.d.ts"
      ],
      "locales": [
        "./dist/locales.d.ts"
      ],
      "sepomex": [
        "./dist/sepomex.d.ts"
      ],
      "all": [
        "./dist/global.d.ts"
      ],
      "rrhh": [
        "./dist/rrhh.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "bin",
    "!dist/**/*.map",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "keywords": [
    "dialog",
    "modal",
    "alert",
    "confirm",
    "prompt",
    "toast",
    "drawer",
    "bottom-sheet",
    "form",
    "wizard",
    "sweetalert",
    "accessibility",
    "a11y",
    "rfc",
    "curp",
    "clabe",
    "mexico",
    "rrhh",
    "approval",
    "vue",
    "react",
    "angular",
    "sweetalert2",
    "native-dialog",
    "shadow-dom",
    "typescript",
    "zero-dependencies",
    "form-validation",
    "enterprise"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "scripts": {
    "dev": "vite --open /test/paginas/",
    "build": "vite build --mode core && vite build --mode all && vite build --mode forms && vite build --mode toast && vite build --mode themes && vite build --mode patterns && vite build --mode mx && vite build --mode vue && vite build --mode react && vite build --mode angular && vite build --mode swal && vite build --mode swalglobal && vite build --mode import && vite build --mode table && vite build --mode tabs && vite build --mode timeline && vite build --mode locales && vite build --mode sepomex && vite build --mode rrhh && tsc -p tsconfig.build.json && node scripts/tipos.mjs",
    "build:site": "vite build --mode site",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "nueva-version": "node scripts/nueva-version.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "node scripts/tamano.mjs",
    "bench": "node scripts/bench.mjs",
    "api": "node scripts/api.mjs",
    "api:check": "node scripts/api.mjs --check",
    "idiomas": "node scripts/idiomas.mjs",
    "idiomas:check": "node scripts/idiomas.mjs --check",
    "compat": "node scripts/compat.mjs",
    "compat:check": "node scripts/compat.mjs --check",
    "check:node": "node scripts/probar-node.mjs",
    "check:paquete": "attw --pack . --ignore-rules cjs-resolves-to-esm && node scripts/probar-paquete.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@angular/core": ">=16",
    "react": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/core": "^22.2.5",
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "marked": "^18.2.0",
    "nexus-i18n": "github:urieldomingezm/nexus-i18n",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45"
  }
}
